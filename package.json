{
  "name": "@mralaminahamed/legal-rag",
  "version": "0.1.0",
  "private": true,
  "author": "Al Amin Ahamed <mrabir.ahamed@gmail.com>",
  "description": "RAG system for legal document understanding — Case Fact Summary generation with edit-loop improvement",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "build:api": "npm --workspace apps/api run build",
    "demo": "tsx scripts/e2e-walkthrough.ts",
    "test:api": "npm --workspace apps/api run test",
    "test:ocr": "docker compose run --rm ocr pytest tests/ -v",
    "test": "npm run test:api && npm run test:ocr",
    "test:unit": "npm --workspace apps/api run test:unit",
    "test:integration": "npm --workspace apps/api run test:integration",
    "eval:grounding": "tsx eval/grounding-precision.ts",
    "eval:convergence": "CONFIRM_RESET=1 tsx eval/edit-convergence.ts",
    "eval:full": "CONFIRM_RESET=1 tsx eval/run-full.ts",
    "eval:simulate": "tsx eval/simulate-operator.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "CONFIRM_RESET=1 tsx scripts/db-reset.ts",
    "generate:samples": "tsx scripts/generate-samples.ts",
    "generate:degraded": "docker compose run --rm -v $(pwd)/scripts:/app/scripts -v $(pwd)/samples:/app/samples ocr python /app/scripts/generate-degraded-samples.py",
    "generate:scanned": "docker compose run --rm -v $(pwd)/scripts:/app/scripts -v $(pwd)/samples:/app/samples ocr python /app/scripts/generate-scanned-samples.py",
    "generate:all": "npm run generate:samples && npm run generate:degraded && npm run generate:scanned"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.3",
    "pdfkit": "^0.14.0",
    "tsx": "^4.15.6"
  }
}
