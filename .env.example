# ─────────────────────────────────────────────────
# Legal RAG — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────

# LLM providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Anthropic model names (configurable — never hardcode in source)
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Postgres connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://legal:secret@localhost:5432/legalrag

# OCR sidecar base URL (no trailing slash)
OCR_SERVICE_URL=http://localhost:8000

# API server
PORT_API=3000

# OCR sidecar
PORT_OCR=8000

# Logging
# Accepted pino levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Postgres credentials (used by docker-compose db service)
POSTGRES_USER=legal
POSTGRES_PASSWORD=secret
POSTGRES_DB=legalrag
