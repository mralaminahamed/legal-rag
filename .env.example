# ─────────────────────────────────────────────────
# Legal RAG — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────

# ── LLM provider selection ────────────────────────────────────────────────────
# Valid values: anthropic | openai | ollama
# Default when unset: anthropic
# Only the credential matching the selected provider is required for chat.
# OPENAI_API_KEY is always required regardless of LLM_PROVIDER (used for embeddings).
LLM_PROVIDER=anthropic

# ── Chat provider credentials ─────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Required when LLM_PROVIDER=openai, AND always required for embeddings
OPENAI_API_KEY=sk-...

# ── Chat model names (configurable — never hardcode in source) ────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama (LLM_PROVIDER=ollama) ──────────────────────────────────────────────
# Ollama runs on the HOST machine, not inside Docker. Before using this option:
#   1. Install Ollama: https://ollama.com
#   2. Pull the model: ollama pull qwen2.5:14b-instruct-q5_K_M
#   3. Ensure Ollama is serving: ollama serve
#
# host.docker.internal resolves to the host machine from inside Docker
# on Mac and Windows. Linux users may need:
#   - http://172.17.0.1:11434/v1  (default Docker bridge gateway), or
#   - http://localhost:11434/v1   with --network host on the api container
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Preferred model (~10 GB RAM). Lighter alternative for <16 GB RAM:
#   llama3.1:8b-instruct-q5_K_M  (~6 GB)
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct-q5_K_M

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://legal:secret@localhost:5432/legalrag

# ── Service URLs ──────────────────────────────────────────────────────────────
# OCR sidecar base URL (no trailing slash)
OCR_SERVICE_URL=http://localhost:8000

# ── Ports ─────────────────────────────────────────────────────────────────────
PORT_API=3000
PORT_OCR=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# Accepted pino levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Postgres credentials (docker-compose db service) ─────────────────────────
POSTGRES_USER=legal
POSTGRES_PASSWORD=secret
POSTGRES_DB=legalrag
